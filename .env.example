# ============================================================================
# Flag Skool — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# keys. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle —
# only put values there that are safe for anyone to read.
# ============================================================================

# ---------------------------------------------------------------------------
# STAGE 1 — Supabase (schema, RLS, auth, seed)
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

# Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security entirely — it is the key that
# creates enrollments from the Paystack webhook. It must never be prefixed
# NEXT_PUBLIC_ and must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Supabase CLI for `supabase link` / `db push`.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site origin. Auth redirects, email links, and OG URLs resolve
# against this. Use http://localhost:3001 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# STAGE 1 (optional) — Google OAuth
# Configured in Supabase -> Authentication -> Providers -> Google.
# Only needed here if a server-side flow reads them; the provider config lives
# in Supabase itself.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# STAGE 2 — Paystack (money path). Not needed yet.
# Test keys work immediately; live keys require business verification.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# STAGE 2 — Bunny Stream (signed video). Not needed yet.
# BUNNY_TOKEN_AUTH_KEY signs playback URLs and must stay server-only.
# ---------------------------------------------------------------------------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_TOKEN_AUTH_KEY=
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME=

# ---------------------------------------------------------------------------
# STAGE 3 — Resend (transactional + behavioural email). Not needed yet.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
