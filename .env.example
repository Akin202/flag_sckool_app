# ============================================================================
# Flag Skool — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# keys. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle —
# only put values there that are safe for anyone to read.
# ============================================================================

# ---------------------------------------------------------------------------
# STAGE 1 — Supabase (schema, RLS, auth, seed)
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

# Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row level security entirely — it is the key that
# creates enrollments from the Paystack webhook. It must never be prefixed
# NEXT_PUBLIC_ and must never be imported into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Used by the Supabase CLI for `supabase link` / `db push`.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical site origin. Auth redirects, email links, and OG URLs resolve
# against this. Use http://localhost:3001 locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# STAGE 1 (optional) — Google OAuth
# Configured in Supabase -> Authentication -> Providers -> Google.
# Only needed here if a server-side flow reads them; the provider config lives
# in Supabase itself.
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# STAGE 2 — Paystack (money path). Not needed yet.
# Test keys work immediately; live keys require business verification.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# STAGE 2 — Bunny Stream (signed video).
#
# Bunny has TWO token systems with TWO different keys, and they are easy to
# confuse:
#
#   - Embed View Token Auth  — secures the iframe.mediadelivery.net player.
#     Key lives at Stream -> library -> API. WE DO NOT USE THIS.
#   - CDN Token Auth         — secures direct URLs: playlist.m3u8, segments,
#     MP4 fallbacks, thumbnails. Key lives on the library's PULL ZONE, under
#     Pull Zone -> Security -> "URL Token Authentication Key". THIS IS OURS.
#
# We play through our own <video> + hls.js rather than Bunny's iframe, because
# Bunny's player.js API exposes no way to set quality — and "480p, never auto"
# is a hard constraint here, not a preference. So the pull zone key is the one
# that matters.
#
# None of these are NEXT_PUBLIC_. Playback URLs are minted server-side, so the
# whole block stays server-only and "did a key reach the bundle" is a grep.
# ---------------------------------------------------------------------------

# Stream -> library -> API -> "CDN Hostname". Looks like vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_CDN_HOSTNAME=

# The PULL ZONE key, not the library's embed key. Signs every playback URL.
BUNNY_CDN_TOKEN_KEY=

# Both only used by `npm run bunny:sync`, which maps Bunny video GUIDs onto
# lessons.bunny_video_id. Not read at runtime.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=

# ---------------------------------------------------------------------------
# STAGE 3 — Resend (transactional + behavioural email). Not needed yet.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
